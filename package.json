{
  "name": "talon",
  "private": true,
  "version": "0.1.0",
  "description": "Talon - Tennessee Tech payroll & web-clock system (redesign)",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "prisma:migrate": "npm run prisma:migrate --workspace=server",
    "prisma:seed": "npm run prisma:seed --workspace=server",
    "prisma:studio": "npm run prisma:studio --workspace=server"
  }
}
