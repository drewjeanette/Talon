# Local Workers dev server (npm run dev:server). After deploying, point this at
# your Worker URL, e.g. https://talon-api.<your-subdomain>.workers.dev/api
VITE_API_BASE_URL=http://localhost:8787/api

# Set to true to preview the UI with in-memory fake data instead of a real
# backend - no Worker or D1 needed. See client/src/api/mock.ts.
VITE_MOCK_MODE=false
