# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# App server port - intentionally non-default (not 3000/8080/5000)
PORT=4317

# MySQL connection (matches docker-compose.yml host port)
DATABASE_URL="mysql://talon_app:change_me_app@localhost:13306/talon"

# JWT secrets - generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Password hashing cost factor
BCRYPT_SALT_ROUNDS=12

# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Optional network allowlisting (defense in depth only - real enforcement
# belongs at the firewall/VPC/Cloudflare layer, see docs/SECURITY.md).
# Comma-separated CIDR blocks, e.g. TN Tech's campus subnet(s).
# Leave empty to disable.
ALLOWED_CIDRS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
