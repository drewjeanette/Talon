{
  "name": "server",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply talon-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply talon-db --remote",
    "db:seed:generate": "node seed/generate-seed.mjs",
    "db:seed:local": "wrangler d1 execute talon-db --local --file=./seed/seed.sql",
    "db:seed:remote": "wrangler d1 execute talon-db --remote --file=./seed/seed.sql",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "jose": "^6.2.12",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.130.0"
  }
}
